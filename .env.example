# Local foundation; these disposable credentials are only for localhost.
DATABASE_URL=postgresql+psycopg://maxx:maxx_local@127.0.0.1:55432/maxx
POSTGRES_USER=maxx
POSTGRES_PASSWORD=maxx_local
POSTGRES_DB=maxx
POSTGRES_PORT=55432
# Server-only: never prefix secrets with NEXT_PUBLIC_.
API_BASE_URL=http://127.0.0.1:8000
# The browser-facing web origin. OAuth callbacks, emailed links, cookie security (https => Secure)
# and the same-origin write check all derive from it. Open the app at exactly this address.
PUBLIC_BASE_URL=http://localhost:3001

# Server-only Nebius and Tavily providers. PayPal remains deferred.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Provisional IDs from the project spec; verify against /v1/models with your key.
MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_REASON=nvidia/nemotron-3-super-120b-a12b
MODEL_NEGOTIATOR=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_EMBED=Qwen/Qwen3-Embedding-8B
TAVILY_API_KEY=
# Money layer. off = original no-payment demo. simulator = built-in, clearly labelled PayPal stand-in
# (no keys needed). sandbox = PayPal's sandbox with the credentials below. Live payments are not supported.
PAYPAL_MODE=off
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional: PYUSD (PayPal's stablecoin) checkout. Read-only verification, Maxx holds no wallet key.
PYUSD_RPC_URL=
PYUSD_CHAIN=ethereum-sepolia
PYUSD_CONTRACT=
PYUSD_DEPOSIT_ADDRESS=

# Scan milestone: live is the default; missing keys produce an actionable error.
# Use fixture explicitly for the supplied samples; never silently falls back.
SCAN_MODE=live
PROVIDER_TIMEOUT=20

# Offline-first negotiation: explicit fixtures, no provider fallback.
NEGOTIATION_MODE=fixture
MODEL_SELLER=nvidia/nemotron-3-super-120b-a12b
# MODEL_NEGOTIATOR above remains provisional; verify against your authenticated catalogue.
NEGOTIATION_TIMEOUT=90
FIXTURE_ROUND_DELAY=0.4
# Catalogue matcher: exact/rule fixtures or real Nebius embeddings. No automatic fallback.
MATCH_MODE=fixture

# One PostgreSQL DATABASE_URL stores all application state, jobs, events, cache and calls.
# Open period is persisted per Bloc; server worker closes due Blocs.
BLOC_OPEN_SECONDS=3600
WORKER_ENABLED=true
# Exact model IDs mapped to input/output USD per million tokens, effective_date and (for vision
# models) image_tokens. Unset uses the Token Factory rates built into config.py. A model with no
# rate is never called, so "{}" switches all live AI off. Server-side only, never NEXT_PUBLIC_.
# MODEL_RATES_JSON=
# The AI spending cap (docs/ai-guardrails.md). Every paid call holds its worst-case cost against
# each limit first; at a limit, live AI pauses with a clear message and the rest of the app works.
AI_BUDGET_USD=20
AI_DAILY_BUDGET_USD=0.40
AI_ANONYMOUS_DAILY_BUDGET_USD=0.08
AI_ADDRESS_DAILY_BUDGET_USD=0.02
AI_USER_DAILY_BUDGET_USD=0.05
AI_PREMIUM_USER_DAILY_BUDGET_USD=0.25
AI_NEGOTIATION_WORST_USD=0.10
# Part of each day kept for negotiations; scans and matches by people share the rest.
AI_NEGOTIATION_DAILY_BUDGET_USD=0.20
# Within that share, what the negotiations of one person's Blocs may use each day.
AI_OWNER_NEGOTIATION_DAILY_BUDGET_USD=0.10
# The most one `make verify-guardrails RUN="--run --yes"` may spend.
AI_VERIFY_BUDGET_USD=1
AI_MAX_CALLS_PER_SCAN=10
AI_MAX_CALLS_PER_NEGOTIATION=120
# true switches every live AI call off (the admin console has the same switch).
AI_PAUSED=false
# false: visitors must sign in before any live AI call (recommended for a public launch).
AI_ANONYMOUS_LIVE=true
# Tavily: 1 credit per basic search, 1 per 5 extracted pages. The free plan has 1,000 a month.
TAVILY_MONTHLY_CREDITS=900
TAVILY_DAILY_CREDITS=40

# Accounts. Email + password works with no setup. Leave a provider's pair empty to hide it.
# Register the callback  <PUBLIC_BASE_URL>/api/auth/oauth/<provider>/callback  for each provider
# (google, apple, microsoft, github). See docs/accounts.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple needs all four. APPLE_CLIENT_ID is the Services ID; APPLE_PRIVATE_KEY is the .p8 text
# (newlines may be written as \n). Apple only works on a public https domain, never localhost.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (personal + work/school), consumers (personal only), organizations, or a tenant id.
MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Verification and password-reset mail. `log` prints the message, with its link, in the API log
# (local development only). `smtp` sends through your provider.
EMAIL_MODE=log
EMAIL_FROM=Maxx <no-reply@maxx.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated verified emails allowed to reset the shared demo Blocs. Empty = any signed-in user.
ADMIN_EMAILS=
SESSION_DAYS=30
# Honour X-Forwarded-For from the Next proxy for rate limits. Keep true only while the API is private.
TRUST_PROXY_HEADERS=true

# --- Security posture --------------------------------------------------------------------------
# development | production. Production refuses to start with insecure settings (see docs/security.md).
ENVIRONMENT=development
# 32+ random characters; encrypts authenticator seeds at rest. Required in production. In development
# one is generated into .local/secret_key. Back it up: losing it makes stored seeds unreadable.
SECRET_KEY=
# Comma-separated host names the API answers to (production). * allows any, development only.
ALLOWED_HOSTS=*
# Defaults: on in development, off in production.
DOCS_ENABLED=
SESSION_DAYS=30
SESSION_IDLE_DAYS=14
# Minutes a password/passkey/code check stays fresh for sensitive changes.
REAUTH_MINUTES=10
TRUSTED_DEVICE_DAYS=30
# Screen new passwords against Have I Been Pwned (k-anonymity; only a 5-character hash prefix is sent).
HIBP_ENABLED=true
# Optional Cloudflare Turnstile for sign-up, recovery and repeated failed sign-ins. Both the Next.js
# and API processes read this file, so the site key reaches the browser policy automatically.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Per-address request budget per minute, and live-stream connections per address.
API_RATE_PER_MINUTE=600
STREAM_CONNECTIONS_PER_IP=6

# Marketplace. Sellers are paid when they ship; unshipped orders are refunded.
# auto: a seller goes live once their payout email is confirmed. manual: an administrator approves
# (required in production).
SELLER_REVIEW=auto
SHIP_GRACE_DAYS=2
ADDRESS_WAIT_DAYS=7
DELIVERY_AUTO_CONFIRM_DAYS=14
ADDRESS_RETENTION_DAYS=90
PAYOUT_COOLDOWN_HOURS=0
CASE_RESPONSE_HOURS=24
# Carrier tracking: off | simulator | easypost. With it on, a new seller is paid when the carrier
# reports delivery; after PAYOUT_TRUSTED_AFTER_DELIVERIES clean deliveries, at the first scan.
# easypost needs both keys; the webhook is only a hint and every update is re-read with the key.
TRACKING_MODE=simulator
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
TRACKING_SIM_STEP_SECONDS=60
TRACKING_POLL_MINUTES=30
TRACKING_NO_SCAN_DAYS=4
PAYOUT_TRUSTED_AFTER_DELIVERIES=5
# Seller identity: off | simulator | stripe (Stripe Identity document and selfie check).
VERIFY_MODE=simulator
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SELLER_IDENTITY_REQUIRED=true
# OFAC SDN screening of every seller (list refreshed hourly from the U.S. Treasury). Possible
# matches go to a person in /admin; nobody is blocked automatically.
SANCTIONS_THRESHOLD=0.9
# INFORM Consumers Act: high-volume sellers must give a tax id within SELLER_INFO_DAYS.
HIGH_VOLUME_SALES=200
HIGH_VOLUME_REVENUE=5000
SELLER_INFO_DAYS=10
# Seller listings and AI agents.
LISTING_MAX_PER_SELLER=20
SELLER_AI_MAX_ROUND_DROP_PERCENT=15
# Demo only: simulated sellers turn their wins into real orders and ship with simulated tracking.
SIMULATED_SELLERS=true
SIMULATED_SELLER_SHIP_SECONDS=30
# Judge tools (seller tour). Empty: on outside production. Needs PAYPAL_MODE=simulator.
DEMO_TOOLS=
EMAIL_MAX_ATTEMPTS=6
# Money limits and the emergency brake.
HOLD_MAX_AMOUNT=1000
HOLD_OUTSTANDING_MAX_PER_USER=3000
HOLD_OPEN_MAX_PER_USER=10
HOLD_REAUTH_OVER=300
CHECKOUT_REAUTH_OVER=200
PAYMENTS_FROZEN=false
# Database pool and list cache (traffic).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
LIST_CACHE_SECONDS=1
# Who the legal pages say operates Maxx. Placeholders until a real entity exists.
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=
CONTACT_EMAIL=
LEGAL_EMAIL=
PRIVACY_EMAIL=
SECURITY_EMAIL=
SUPPORT_EMAIL=
SELLER_EMAIL=
